# ==========================================
# CleanCity Backend - Railway Environment Variables
# ==========================================

# Puerto y entorno
NODE_ENV=production
PORT=3000

# Base de datos PostgreSQL (Railway lo autogenera al crear el servicio PostgreSQL)
DATABASE_URL=postgresql://postgres:password@roundhouse.proxy.rlwy.net:5432/railway

# Cache y Cola BullMQ (Railway lo autogenera al crear el servicio Redis)
REDIS_URL=redis://default:password@roundhouse.proxy.rlwy.net:6379

# Autenticación JWT y Cifrado
JWT_SECRET=super-secure-production-jwt-secret-cleancity-2026-min-32-chars!
WALLET_ENCRYPTION_KEY=super-secret-wallet-master-key-32-bytes-long!
COOKIE_SAME_SITE=none

# URL del Frontend en Render (para CORS y cookies seguras)
FRONTEND_URL=https://tu-pwa-frontend.onrender.com

# Red Blockchain Ethereum Sepolia
SEPOLIA_RPC_URL=https://rpc.sepolia.org
CONTRACT_ADDRESS=0x5FbDB2315678afecb367f032d93F642f64180aa3
OPERATOR_PRIVATE_KEY=0xac0974bec39a17e36ba4a6b4d238ff944bacb478cbed5efcae784d7bf4f2ff80
