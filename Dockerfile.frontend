# Multi-stage production Dockerfile for Frontend (Next.js PWA)
FROM node:20-alpine AS builder

WORKDIR /app
RUN npm install -g pnpm

# Copy workspace configuration and PWA package.json
COPY pnpm-lock.yaml pnpm-workspace.yaml package.json ./
COPY apps/pwa/package.json ./apps/pwa/

# Install PWA dependencies in monorepo context
RUN pnpm install --filter pwa... --prod=false

# Copy PWA source code
COPY apps/pwa ./apps/pwa

# Build Next.js PWA
WORKDIR /app/apps/pwa
ARG BACKEND_URL
ARG NEXT_PUBLIC_API_URL
ENV BACKEND_URL=${BACKEND_URL}
ENV NEXT_PUBLIC_API_URL=${NEXT_PUBLIC_API_URL}
ENV NODE_ENV=production

RUN pnpm build

# Production Runner Stage
FROM node:20-alpine AS runner

WORKDIR /app
RUN npm install -g pnpm

ENV NODE_ENV=production
ENV PORT=3000

# Copy workspace files and production dependencies
COPY --from=builder /app/package.json /app/pnpm-workspace.yaml ./
COPY --from=builder /app/node_modules ./node_modules
COPY --from=builder /app/apps/pwa/node_modules ./apps/pwa/node_modules
COPY --from=builder /app/apps/pwa/package.json ./apps/pwa/package.json

# Copy built Next.js artifacts and public assets
COPY --from=builder /app/apps/pwa/.next ./apps/pwa/.next
COPY --from=builder /app/apps/pwa/public ./apps/pwa/public
COPY --from=builder /app/apps/pwa/next.config.js ./apps/pwa/next.config.js

WORKDIR /app/apps/pwa

EXPOSE 3000

CMD ["pnpm", "start"]
